{
	"name": "@gravatar-com/gravatar",
	"description": "A React component for Gravatar profile images, built on the WordPress UI Avatar.",
	"homepage": "https://github.com/Automattic/gravatar/blob/trunk/web/packages/gravatar#readme",
	"bugs": "https://github.com/Automattic/gravatar/issues",
	"repository": "https://github.com/Automattic/gravatar/blob/trunk/web/packages/gravatar",
	"version": "0.0.1",
	"author": "Automattic Inc.",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"gravatar",
		"avatar",
		"react",
		"profile"
	],
	"scripts": {
		"test:unit": "wp-scripts test-unit-js",
		"test:unit:help": "wp-scripts test-unit-js --help",
		"test:unit:watch": "wp-scripts test-unit-js --watch",
		"test:unit:debug": "wp-scripts --inspect-brk test-unit-js --runInBand --no-cache",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:md": "wp-scripts lint-md-docs",
		"lint": "run-p 'lint:*'",
		"type-check": "tsc --noEmit",
		"build": "npm run clean:dist && run-p 'build:types' 'build:core'",
		"build:types": "tsc --declaration --declarationMap --emitDeclarationOnly",
		"build:dev": "npm run clean:dist && run-p 'build:types' 'build:core --node-env=development'",
		"build:watch": "npm run build:dev && watch 'npm run build:dev' ./src",
		"clean:dist": "rimraf dist",
		"clean:release": "rimraf release",
		"clean": "run-p 'clean:*'",
		"release": "release-it",
		"build:core": "webpack --config ./webpack/config.core.js --node-env=production"
	},
	"files": [
		"dist",
		"README.md"
	],
	"types": "dist/index.d.ts",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"peerDependencies": {
		"@wordpress/ui": "*",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	},
	"devDependencies": {
		"@babel/preset-react": "^7.22.5",
		"@jest/globals": "^29.7.0",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22.6.1",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"babel-loader": "^9.1.3",
		"lint-staged": "^15.2.10",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"release-it": "^17.4.0",
		"rimraf": "^5.0.1",
		"typescript": "^5.1.6",
		"webpack": "^5.91.0",
		"webpack-cli": "^5.1.4"
	},
	"dependencies": {
		"@babel/preset-typescript": "^7.24.7",
		"js-sha256": "^0.11.0",
		"terser-webpack-plugin": "^5.3.10",
		"webpack-remove-empty-scripts": "^1.0.4"
	}
}
